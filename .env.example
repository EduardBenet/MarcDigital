# Copy to `.env` (gitignored) for local dev. On balenaCloud these are set as
# fleet/device service variables instead. No real secrets in this example file.

# Entra service principal (Storage Blob Data Reader on the container)
AZURE_TENANT_ID=your-entra-tenant-id
AZURE_CLIENT_ID=your-service-principal-app-id
AZURE_CLIENT_SECRET=your-service-principal-secret

# Azure Blob location
AZURE_STORAGE_ACCOUNT=marcdigital
CONTAINER_NAME=photos

# Optional (defaults shown)
# SYNCED_PHOTOS_DIR=./synced_photos
# ROTATION_SECONDS=30
# SYNC_INTERVAL_SECONDS=1800
